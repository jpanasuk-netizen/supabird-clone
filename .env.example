# Copy to .env.local (gitignored). Do not put real tokens in git.
# Builtin FCC: prefer house Free Claude Code on 127.0.0.1:8080.
# Idea generate picks a healthy local catalog model (Sonnet 4.6 if it works; never NVIDIA NIM).
# FCC_BASE_URL=http://127.0.0.1:8080/v1
# FCC_MODEL=
ANTHROPIC_API_KEY=local
# Provider: fcc, vyce, or custom
PROVIDER=fcc
# VYCE gpt-6-luna for AI when key set. Model id is fixed in the server.
# VYCE_API_KEY=
# Custom OpenAI-compatible (only used when PROVIDER=custom)
# CUSTOM_BASE_URL=http://127.0.0.1:8781/v1
# CUSTOM_MODEL=
# CUSTOM_API_KEY=
# X OAuth 2.0 Client ID — optional. Prefer the in-app Sign in panel (saved to data/).
# Callback on the X developer app: http://127.0.0.1:4747/callback/x
# Native / PKCE; Client secret optional.
# X_CLIENT_ID=
# X_CLIENT_SECRET=
